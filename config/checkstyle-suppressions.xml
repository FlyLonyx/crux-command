<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>

    <!-- Test names are sentences, and a test method documents itself. -->
    <suppress files="[\\/]src[\\/]test[\\/]"
              checks="MissingJavadocMethod|MissingJavadocType|JavadocMethod|JavadocType|JavadocStyle|JavadocPackage|VisibilityModifier|MethodName"/>

    <!-- JUnit instantiates test classes, so they cannot hide a constructor. -->
    <suppress files="[\\/]src[\\/]test[\\/]" checks="HideUtilityClassConstructor"/>

    <!-- Fixtures exist to reproduce the patterns the rules forbid. -->
    <suppress files="[\\/]src[\\/]test[\\/].*[\\/]fixture[\\/]" checks="[a-zA-Z0-9]*"/>

</suppressions>
